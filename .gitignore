# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-electron/
build/Release/
*.tsbuildinfo
.turbo/

# 分布式 CLI（zhshield-cli）需随仓库分发自包含 bundle，供 GitHub Action 直装、
# 绕开 npm。仅提交 dist/zhshield.js 与 dist/sop/（运行时必需）；源映射与
# .mjs 变体体积大且非必需，仍忽略。
!packages/cli/dist/
!packages/cli/dist/**
packages/cli/dist/*.map
packages/cli/dist/zhshield.mjs
packages/cli/dist/zhshield.mjs.map

# Stale compiled artifacts in source directories (tsconfig outputs to dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/electron/**/*.js
packages/*/electron/**/*.js.map
packages/*/electron/**/*.d.ts
packages/*/electron/**/*.d.ts.map
packages/*/vitest.config.js
packages/*/vitest.config.js.map
packages/*/vitest.config.d.ts
packages/*/vitest.config.d.ts.map
packages/*/vite.config.js
packages/*/vite.config.js.map
packages/*/vite.config.d.ts
packages/*/vite.config.d.ts.map
packages/*/playwright.config.js
packages/*/playwright.config.js.map
packages/*/playwright.config.d.ts
packages/*/playwright.config.d.ts.map
scripts/*.js
scripts/*.js.map
scripts/*.d.ts
scripts/*.d.ts.map
vitest.workspace.js
vitest.workspace.js.map
vitest.workspace.d.ts
vitest.workspace.d.ts.map

# Test / coverage
coverage/
coverage-summary.json
*.lcov
test-results/
playwright-report/
*.zip

# Electron / packaging
# 构建产物输出至仓库外（../../../build-output），此处不再需要忽略
*.dmg
*.app
*.exe
*.AppImage
*.blockmap
*.snap

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Logs & caches
logs/
*.log
npm-debug.log*
pnpm-debug.log*
.eslintcache
.cache/
.vite/
*.local

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temp / scratch
_tmp_*
.tmp/
.temp/
.zhshield/

# Semgrep inline 临时规则（semgrep ci --config inline 生成）
**/.semgrep/

# 重复代码报告（jscpd）
report/

# Vitest
.vitest/

# 根级 tsc 产物（vitest 配置编译输出，源为 .ts）
/vitest.config.js
/vitest.config.js.map
/vitest.config.d.ts
/vitest.config.d.ts.map
/vitest.shared.js
/vitest.shared.js.map
/vitest.shared.d.ts
/vitest.shared.d.ts.map

# CLI 自包含 bundle 内的编译产物：仅 dist/zhshield.js 与 dist/sop/**/*.ts、*.yml 入库；
# 其余 .js/.d.ts/.map 由 tsc 生成，体积大且非运行时必需（覆盖上方 !packages/cli/dist/**）
packages/cli/dist/**/*.js
packages/cli/dist/**/*.js.map
packages/cli/dist/**/*.d.ts
packages/cli/dist/**/*.d.ts.map

# desktop e2e 编译产物（源为 .ts）
packages/desktop/e2e/*.js
packages/desktop/e2e/*.js.map
packages/desktop/e2e/*.d.ts
packages/desktop/e2e/*.d.ts.map

# 测试 fixture 编译产物（仅保留源码 .ts 与元数据文件入库）
scripts/fixtures/sample-repo/**/*.js
scripts/fixtures/sample-repo/**/*.js.map
scripts/fixtures/sample-repo/**/*.d.ts
scripts/fixtures/sample-repo/**/*.d.ts.map
packages/fingerprint/fixtures/golden/**/*.js
packages/fingerprint/fixtures/golden/**/*.js.map
packages/fingerprint/fixtures/golden/**/*.d.ts
packages/fingerprint/fixtures/golden/**/*.d.ts.map
packages/inspect/e2e/fixtures/**/*.js
packages/inspect/e2e/fixtures/**/*.js.map
packages/inspect/e2e/fixtures/**/*.d.ts
packages/inspect/e2e/fixtures/**/*.d.ts.map

# 扫描运行产物（根级 zhshield.json、fixture 内扫描结果）；源码与配置入库
/zhshield.json
packages/inspect/e2e/fixtures/**/zhshield.json

# OpenCode 运行时状态（会话账本/续跑/boulder），非仓库资产；plans 与报告保留跟踪
.omo/boulder.json
.omo/start-work/
.omo/run-continuation/
