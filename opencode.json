{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git stash": "deny",
      "git stash *": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git checkout * -- *": "deny",
      "git restore*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git clean -x*": "deny"
    }
  }
}
