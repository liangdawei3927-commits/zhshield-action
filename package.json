{
  "name": "zhiyan-codeshield",
  "version": "0.1.0",
  "private": true,
  "description": "智汇码盾 - 模块化单体代码治理平台",
  "scripts": {
    "build": "turbo run build --concurrency=$(node scripts/turbo-concurrency.mjs) && node scripts/sync-snapshot-links.mjs",
    "dev": "turbo run dev --concurrency=$(node scripts/turbo-concurrency.mjs)",
    "sync:snapshot-links": "node scripts/sync-snapshot-links.mjs",
    "sync:snapshot-links:check": "node scripts/sync-snapshot-links.mjs --check",
    "lint": "turbo run lint --concurrency=$(node scripts/turbo-concurrency.mjs)",
    "lint:root": "eslint . --max-warnings 0",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,cjs,js}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,cjs,js}\"",
    "test": "turbo run test --concurrency=1",
    "bench": "node scripts/benchmark.mjs",
    "bench:db": "node packages/db/scripts/bench-batch.mjs",
    "bench:perf": "node packages/autoperf/scripts/bench-scan.mjs",
    "bench:gate": "node scripts/benchmark.mjs --gate",
    "bench:base": "node scripts/benchmark.mjs --sample --save-base scripts/fixtures/.benchmark-baseline.json",
    "clean": "turbo run clean",
    "check": "node scripts/zhcheck.mjs --all",
    "check:ci": "node scripts/zhcheck.mjs --all --ci",
    "verify": "bash scripts/verify-env.sh",
    "verify:fix": "bash scripts/verify-env.sh --fix",
    "check:staged": "node scripts/zhcheck.mjs --refactor --inspect --staged --ci",
    "check:refactor": "node scripts/zhcheck.mjs --refactor",
    "hooks:install": "node scripts/zhcheck.mjs --install-hooks",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.1.1",
    "@eslint/js": "^9.22.0",
    "@vitest/coverage-v8": "^4.1.10",
    "depcheck": "^1.4.7",
    "eslint": "^9.22.0",
    "globals": "^17.8.0",
    "prettier": "^3.3.0",
    "ts-prune": "^0.10.3",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
