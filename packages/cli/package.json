{
  "name": "@zh/cli",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "zhshield": "./bin/zhshield.mjs"
  },
  "scripts": {
    "guard": "tsx src/index.ts guard",
    "inspect": "tsx src/index.ts inspect",
    "pipeline": "tsx src/index.ts pipeline",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src bin --max-warnings 50"
  },
  "dependencies": {
    "@zh/pipeline": "workspace:*",
    "@zh/reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "tsx": "^4.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
