{
  "name": "@zh/desktop",
  "version": "0.1.1",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm exec turbo run build --filter=@zh/desktop^... && node ../../scripts/sync-snapshot-links.mjs && vite",
    "build": "tsc && vite build",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint src electron --max-warnings 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zh/db": "workspace:*",
    "@zh/dependency": "workspace:*",
    "@zh/evolve": "workspace:*",
    "@zh/fingerprint": "workspace:*",
    "@zh/guard": "workspace:*",
    "@zh/i18n": "workspace:*",
    "@zh/inspect": "workspace:*",
    "@zh/kernel": "workspace:*",
    "@zh/performance": "workspace:*",
    "@zh/pipeline": "workspace:*",
    "@zh/refactor": "workspace:*",
    "@zh/reporter": "workspace:*",
    "@zh/scoring": "workspace:*",
    "@zh/security": "workspace:*",
    "@zh/sentinel": "workspace:*",
    "@zh/shared": "workspace:*",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "dependenciesMeta": {
    "@zh/db": { "injected": true },
    "@zh/dependency": { "injected": true },
    "@zh/evolve": { "injected": true },
    "@zh/fingerprint": { "injected": true },
    "@zh/guard": { "injected": true },
    "@zh/i18n": { "injected": true },
    "@zh/inspect": { "injected": true },
    "@zh/kernel": { "injected": true },
    "@zh/performance": { "injected": true },
    "@zh/pipeline": { "injected": true },
    "@zh/refactor": { "injected": true },
    "@zh/reporter": { "injected": true },
    "@zh/scoring": { "injected": true },
    "@zh/security": { "injected": true },
    "@zh/sentinel": { "injected": true },
    "@zh/shared": { "injected": true }
  },
  "devDependencies": {
    "@electron/windows-sign": "^2.0.6",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.zhihui.codeshield",
    "productName": "智汇码盾",
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/**",
      "package.json",
      "!**/.turbo",
      "!**/.turbo/**",
      "!**/node_modules/.cache",
      "!**/*.log",
      "!**/src",
      "!**/src/**",
      "!**/tsconfig*.json",
      "!**/*.tsbuildinfo",
      "!**/vitest.config.*",
      "!**/*.map",
      "!**/packages/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "../../../build-output"
    },
    "publish": {
      "provider": "github",
      "owner": "liangdawei3927-commits",
      "repo": "zhshield-action"
    },
    "asarUnpack": [
      "dist-electron/zhshield-mcp.js",
      "**/*.node"
    ],
    "npmRebuild": false
  }
}
