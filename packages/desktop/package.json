{
  "name": "@zh/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint src electron --max-warnings 100"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zh/db": "workspace:*",
    "@zh/dependency": "workspace:*",
    "@zh/evolve": "workspace:*",
    "@zh/fingerprint": "workspace:*",
    "@zh/guard": "workspace:*",
    "@zh/inspect": "workspace:*",
    "@zh/kernel": "workspace:*",
    "@zh/pipeline": "workspace:*",
    "@zh/performance": "workspace:*",
    "@zh/refactor": "workspace:*",
    "@zh/reporter": "workspace:*",
    "@zh/scoring": "workspace:*",
    "@zh/security": "workspace:*",
    "@zh/sentinel": "workspace:*",
    "@zh/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3",
    "@zh/i18n": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.zhiyan.codeshield",
    "productName": "智汇码盾",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "dist-electron/zhshield-mcp.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "zhiyan-codeshield",
      "repo": "zhiyan-codeshield"
    }
  }
}
