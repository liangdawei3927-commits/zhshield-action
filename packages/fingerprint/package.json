{
  "name": "@zh/fingerprint",
  "version": "0.1.0",
  "private": true,
  "description": "多语言项目画像探测：Detector 插件体系（M0 架构文档 §11.2）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 100"
  },
  "dependencies": {
    "@zh/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  }
}
