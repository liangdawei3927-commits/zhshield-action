{
  "name": "@zh/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "智汇码盾国际化核心包：五语种目录（zh-Hans / zh-Hant / en / ko / ja）+ i18next 实例 + 语言解析",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 50",
    "merge-fragments": "node scripts/merge-fragments.mjs"
  },
  "dependencies": {
    "i18next": "^24.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "require": "./dist/*"
    }
  }
}
