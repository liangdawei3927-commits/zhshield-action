{
  "name": "@zh/kernel",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc && node scripts/copy-sop-rules.cjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 100"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.6.0",
    "@eslint-performance/plugin-runtime-complexity": "^0.1.6",
    "@typescript-eslint/parser": "^8.65.0",
    "@zh/db": "workspace:*",
    "@zh/shared": "workspace:*",
    "archiver": "^7.0.1",
    "js-yaml": "^4.1.0",
    "@zh/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  }
}
