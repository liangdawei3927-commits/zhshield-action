{
  "name": "@zh/reporter",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 100"
  },
  "dependencies": {
    "@zh/shared": "workspace:*",
    "@zh/kernel": "workspace:*",
    "@zh/guard": "workspace:*",
    "@zh/inspect": "workspace:*",
    "@zh/pipeline": "workspace:*",
    "@zh/refactor": "workspace:*",
    "@zh/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  }
}
